{"version": 2, "width": 100, "height": 34, "title": "MCP Business Tools \u2014 edited-paced replay of actual outputs", "env": {"TERM": "xterm-256color"}}
[0, "o", "\u001b[2J\u001b[HMCP Business Tools\r\nWhat this project demonstrates\r\n\r\nThe MCP server exposes inventory reads and order preparation. Capability scopes come from the server process, never from tool arguments. Stock is committed only through a separate operator approval surface.\r\n"]
[10, "o", "\u001b[2J\u001b[HMCP Business Tools\r\nActual fixture demo output\r\n\r\n{\r\n  \"mode\": \"fixture\",\r\n  \"python\": \"3.12.13\",\r\n  \"recorded_at\": \"2026-10-31T13:52:13.669671+00:00\",\r\n  \"elapsed_seconds\": 0.0128,\r\n  \"result\": {\r\n    \"before\": [\r\n      {\r\n        \"sku\": \"LAP-01\",\r\n        \"name\": \"Demo laptop\",\r\n        \"available\": 7\r\n      }\r\n    ],\r\n    \"prepared\": {\r\n      \"id\": \"d2150bc2-2c8d-44bb-94d4-a7e8946deb28\",\r\n      \"sku\": \"LAP-01\",\r\n      \"quantity\": 2,\r\n      \"status\": \"pending\",\r\n      \"fingerprint\": \"95be3b753a5225035e2649a85f9f3d23f5df11e3447380d5f1c882cde2d4ee39\"\r\n    },\r\n    \"approved\": {\r\n      \"id\": \"d2150bc2-2c8d-44bb-94d4-a7e8946deb28\",\r\n      \"status\": \"committed\",\r\n      \"replayed\": false\r\n    },\r\n    \"replay\": {\r\n      \"id\": \"d2150bc2-2c8d-44bb-94d4-a7e8946deb28\",\r\n      \"status\": \"committed\",\r\n      \"replayed\": true\r\n    },\r\n    \"after\": [\r\n      {\r\n        \"sku\": \"LAP-01\",\r\n        \"name\": \"Demo laptop\",\r\n        \"available\": 5\r\n      }\r\n    ]\r\n  }\r\n}\r\n"]
